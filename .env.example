# Copy to .env (git-ignored) and fill in. NEVER commit a real key.
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=openai/gpt-4o-mini   # any OpenRouter model id that supports tool calling
LLM_MODE=offline                      # offline | live   (default: live only if a key is set)
SETUHAUL_DB=data/working.db
SETUHAUL_NOW=2026-08-04T09:30:00+05:30
HOLD_TTL_SECONDS=300
